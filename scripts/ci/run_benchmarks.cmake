# Builds OpenCV (once per machine), builds the benchmarks of this repository and runs every one of them, then checks
# that FKL's outputs match their references. Runs on Linux and Windows; the CI workflow
# (.github/workflows/benchmarks.yml) runs it on FKL's self-hosted runners, and it runs the same way on any machine:
#
#   cmake -DBENCHMARKS=cpu -DCXX_COMPILER=clang++ -P scripts/ci/run_benchmarks.cmake
#   cmake -DBENCHMARKS=gpu -DCXX_COMPILER=g++-13 -DCUDA_COMPILER=/usr/local/cuda-13.4/bin/nvcc \
#         -P scripts/ci/run_benchmarks.cmake
#
# On Windows, run it from a Visual Studio developer shell (cl, link and ninja in the PATH).
#
#   BENCHMARKS           cpu: the CPU benchmark (cpu/); gpu: the GPU benchmark (src/) and FKL vs NPPDx (fkl-vs-nppdx/)
#   CXX_COMPILER         C++ compiler of the benchmarks; for gpu also the host compiler of nvcc (except with cl, which
#                        nvcc finds in the PATH)
#   CUDA_COMPILER        nvcc, for gpu
#   OPENCV_CXX_COMPILER  C++ compiler for OpenCV (default CXX_COMPILER); OPENCV_C_COMPILER is derived from it
#   NPPDX                ON, OFF or AUTO (default): AUTO builds FKL vs NPPDx on x86_64 only, the only CPU NPPDx supports
#   DEPS_DIR             where OpenCV is built once and reused by later runs (default <home>/bvf-paper-bench-deps)
#   BUILD_DIR            build folders of the benchmarks (default <repo>/build-ci)
#   OUT_DIR              results and logs (default <repo>/ci-results)
#   GENERATOR            CMake generator (default Ninja)
#   OPENCV_VERSION       default 4.14.0, the version of the paper's results; another version needs the SHA-256 of its
#                        source archives in OPENCV_SHA256 and OPENCV_CONTRIB_SHA256
cmake_minimum_required(VERSION 3.28)

get_filename_component(REPO "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(CMAKE_HOST_WIN32)
    set(HOME_DIR "$ENV{USERPROFILE}")
    set(EXE ".exe")
else()
    set(HOME_DIR "$ENV{HOME}")
    set(EXE "")
endif()
foreach(default IN ITEMS "GENERATOR=Ninja" "OPENCV_VERSION=4.14.0" "NPPDX=AUTO" "DEPS_DIR=${HOME_DIR}/bvf-paper-bench-deps"
                         "BUILD_DIR=${REPO}/build-ci" "OUT_DIR=${REPO}/ci-results")
    string(FIND "${default}" "=" eq)
    string(SUBSTRING "${default}" 0 ${eq} name)
    math(EXPR eq "${eq} + 1")
    string(SUBSTRING "${default}" ${eq} -1 value)
    if(NOT DEFINED ${name} OR "${${name}}" STREQUAL "")
        set(${name} "${value}")
    endif()
endforeach()
if(NOT BENCHMARKS MATCHES "^(cpu|gpu)$")
    message(FATAL_ERROR "Set BENCHMARKS to cpu or gpu")
endif()
if(NOT CXX_COMPILER)
    message(FATAL_ERROR "Set CXX_COMPILER")
endif()
if(BENCHMARKS STREQUAL "gpu" AND NOT CUDA_COMPILER)
    message(FATAL_ERROR "Set CUDA_COMPILER for the GPU benchmarks")
endif()
if(NOT OPENCV_CXX_COMPILER)
    set(OPENCV_CXX_COMPILER "${CXX_COMPILER}")
endif()
# The source archives are checked against these hashes (GitHub's archives of the 4.14.0 tags, identical to
# `git archive` of the tags), so that a build in DEPS_DIR, which later jobs reuse, only ever comes from these sources
if(OPENCV_VERSION STREQUAL "4.14.0")
    set(OPENCV_SHA256 ee8fb9b30eb60850431b4656447080e3737b56e45719c92b67f245950609f86e)
    set(OPENCV_CONTRIB_SHA256 4f17abd1bc7f88e19c3380c8de7cbf2d863aced5b5ee8d8934cc7902b67d42c9)
elseif(NOT OPENCV_SHA256 OR NOT OPENCV_CONTRIB_SHA256)
    message(FATAL_ERROR "Set OPENCV_SHA256 and OPENCV_CONTRIB_SHA256 for OpenCV ${OPENCV_VERSION}")
endif()
if(NOT OPENCV_C_COMPILER)
    get_filename_component(cxxName "${OPENCV_CXX_COMPILER}" NAME)
    if(cxxName MATCHES "clang\\+\\+")
        string(REPLACE "clang++" "clang" OPENCV_C_COMPILER "${OPENCV_CXX_COMPILER}")
    elseif(cxxName MATCHES "g\\+\\+")
        string(REPLACE "g++" "gcc" OPENCV_C_COMPILER "${OPENCV_CXX_COMPILER}")
    elseif(cxxName MATCHES "^c\\+\\+")
        string(REPLACE "c++" "cc" OPENCV_C_COMPILER "${OPENCV_CXX_COMPILER}")
    else()
        # cl and clang-cl compile C too
        set(OPENCV_C_COMPILER "${OPENCV_CXX_COMPILER}")
    endif()
endif()

cmake_host_system_information(RESULT HOST_OS QUERY OS_NAME)
cmake_host_system_information(RESULT HOST_ARCH QUERY OS_PLATFORM)
cmake_host_system_information(RESULT CORES QUERY NUMBER_OF_LOGICAL_CORES)
cmake_host_system_information(RESULT MEMORY_MIB QUERY TOTAL_PHYSICAL_MEMORY)
string(TOLOWER "${HOST_OS}-${HOST_ARCH}" HOST_TAG)
set(HOST_X64 FALSE)
if(HOST_ARCH MATCHES "^(x86_64|AMD64|amd64)$")
    set(HOST_X64 TRUE)
endif()
if(NPPDX STREQUAL "AUTO")
    set(NPPDX ${HOST_X64})
endif()
# nvcc can need a few GB per compilation: at most one job per 3 GB of memory
math(EXPR JOBS "${MEMORY_MIB} / 3072")
if(JOBS GREATER CORES)
    set(JOBS ${CORES})
elseif(JOBS LESS 1)
    set(JOBS 1)
endif()

file(MAKE_DIRECTORY "${OUT_DIR}/logs" "${BUILD_DIR}" "${DEPS_DIR}")
set(FAILURES "")

# Runs a command with its output shown and saved in OUT_DIR/logs/<NAME>.log. A failure stops the script with FATAL,
# and is otherwise reported at the end.
function(run NAME)
    cmake_parse_arguments(PARSE_ARGV 1 RUN "FATAL" "" "COMMAND")
    string(REPLACE ";" " " printed "${RUN_COMMAND}")
    message(STATUS "==> ${NAME}: ${printed}")
    string(TIMESTAMP start "%s")
    execute_process(COMMAND ${RUN_COMMAND} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output
                    ECHO_OUTPUT_VARIABLE ECHO_ERROR_VARIABLE)
    string(TIMESTAMP end "%s")
    math(EXPR seconds "${end} - ${start}")
    file(WRITE "${OUT_DIR}/logs/${NAME}.log" "${printed}\n\n${output}")
    file(APPEND "${OUT_DIR}/logs/summary.txt" "${NAME}: exit ${result}, ${seconds} s\n")
    if(NOT result STREQUAL "0")
        if(RUN_FATAL)
            message(FATAL_ERROR "${NAME} failed (${result}), see ${OUT_DIR}/logs/${NAME}.log")
        endif()
        message(WARNING "${NAME} failed (${result})")
        set(FAILURES ${FAILURES} "${NAME} (exit ${result})" PARENT_SCOPE)
    endif()
endfunction()

# Fails the run (at the end) if a column of a CSV file is above MAX, or is not "yes" with MAX yes, in the rows whose
# FILTER_COLUMN matches FILTER (all rows without FILTER)
function(check_csv FILE COLUMN MAX)
    cmake_parse_arguments(PARSE_ARGV 3 CHECK "" "FILTER_COLUMN;FILTER" "")
    set(failures ${FAILURES})
    if(NOT EXISTS "${FILE}")
        list(APPEND failures "${FILE} missing")
        set(FAILURES ${failures} PARENT_SCOPE)
        return()
    endif()
    file(STRINGS "${FILE}" lines)
    list(POP_FRONT lines header)
    string(REPLACE "," ";" header "${header}")
    list(TRANSFORM header STRIP)
    list(FIND header "${COLUMN}" column)
    set(filterColumn -1)
    if(CHECK_FILTER_COLUMN)
        list(FIND header "${CHECK_FILTER_COLUMN}" filterColumn)
    endif()
    if(column EQUAL -1 OR (CHECK_FILTER_COLUMN AND filterColumn EQUAL -1))
        list(APPEND failures "${FILE}: no column ${COLUMN} or ${CHECK_FILTER_COLUMN}")
        set(FAILURES ${failures} PARENT_SCOPE)
        return()
    endif()
    set(checked 0)
    foreach(line IN LISTS lines)
        if(line STREQUAL "")
            continue()
        endif()
        string(REPLACE "," ";" values "${line}")
        list(TRANSFORM values STRIP)
        if(filterColumn GREATER -1)
            list(GET values ${filterColumn} key)
            if(NOT key MATCHES "${CHECK_FILTER}")
                continue()
            endif()
        endif()
        list(GET values ${column} value)
        math(EXPR checked "${checked} + 1")
        if(MAX STREQUAL "yes")
            set(ok FALSE)
            if(value STREQUAL "yes")
                set(ok TRUE)
            endif()
        elseif(value LESS_EQUAL MAX)
            set(ok TRUE)
        else()
            set(ok FALSE)
        endif()
        if(NOT ok)
            list(APPEND failures "${FILE}: ${COLUMN} = ${value} (limit ${MAX}) in: ${line}")
        endif()
    endforeach()
    if(checked EQUAL 0)
        list(APPEND failures "${FILE}: no rows to check for ${COLUMN}")
    endif()
    get_filename_component(name "${FILE}" NAME)
    message(STATUS "Checked ${COLUMN} of ${checked} rows of ${name}")
    set(FAILURES ${failures} PARENT_SCOPE)
endfunction()

# The CUDA toolkit and the GPU of this machine
if(BENCHMARKS STREQUAL "gpu")
    execute_process(COMMAND "${CUDA_COMPILER}" --version OUTPUT_VARIABLE nvccVersion RESULT_VARIABLE result)
    if(NOT result STREQUAL "0" OR NOT nvccVersion MATCHES "release ([0-9]+\\.[0-9]+)")
        message(FATAL_ERROR "Cannot run ${CUDA_COMPILER}")
    endif()
    set(CUDA_VERSION "${CMAKE_MATCH_1}")
    get_filename_component(CUDA_ROOT "${CUDA_COMPILER}" DIRECTORY)
    get_filename_component(CUDA_ROOT "${CUDA_ROOT}" DIRECTORY)
    execute_process(COMMAND nvidia-smi --query-gpu=name,compute_cap --format=csv,noheader
                    OUTPUT_VARIABLE gpus RESULT_VARIABLE result ERROR_QUIET)
    if(result STREQUAL "0" AND gpus MATCHES "^([^\n]*), ([0-9]+)\\.([0-9]+)")
        set(GPU_NAME "${CMAKE_MATCH_1}")
        set(CUDA_ARCH_BIN "${CMAKE_MATCH_2}.${CMAKE_MATCH_3}")
    else()
        # Jetson boards have no full nvidia-smi: ask the CUDA driver, with the tool nvcc uses for -arch=native
        execute_process(COMMAND "${CUDA_ROOT}/bin/__nvcc_device_query${EXE}" OUTPUT_VARIABLE archs RESULT_VARIABLE result)
        if(NOT result STREQUAL "0" OR NOT archs MATCHES "^([0-9]+)([0-9])")
            message(FATAL_ERROR "Neither nvidia-smi nor __nvcc_device_query report a GPU")
        endif()
        set(GPU_NAME "(name not reported by nvidia-smi)")
        set(CUDA_ARCH_BIN "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}")
    endif()
    message(STATUS "GPU 0: ${GPU_NAME} (compute capability ${CUDA_ARCH_BIN}), CUDA ${CUDA_VERSION} in ${CUDA_ROOT}")
endif()

# OpenCV with the modules the benchmarks use, installed in DEPS_DIR. Every configuration is built once per machine and
# reused; a lock lets jobs that run at the same time on one machine wait for each other's build.
function(build_opencv RESULT)
    get_filename_component(compiler "${OPENCV_CXX_COMPILER}" NAME_WE)
    if(CMAKE_HOST_WIN32 AND "$ENV{VCToolsVersion}" MATCHES "^([0-9]+\\.[0-9]+)")
        # OpenCV installs its binaries per Visual Studio runtime: one build per MSVC toolset
        string(APPEND compiler "${CMAKE_MATCH_1}")
    endif()
    if(BENCHMARKS STREQUAL "gpu")
        set(modules core,imgproc,cudev,cudaarithm,cudawarping)
        string(REPLACE "." "" sm "${CUDA_ARCH_BIN}")
        set(tag "${OPENCV_VERSION}-cuda${CUDA_VERSION}-sm${sm}-${HOST_TAG}-${compiler}")
    else()
        set(modules core,imgproc)
        set(tag "${OPENCV_VERSION}-cpu-${HOST_TAG}-${compiler}")
    endif()
    string(TOLOWER "${tag}" tag)
    set(prefix "${DEPS_DIR}/opencv-${tag}")
    set(${RESULT} "${prefix}" PARENT_SCOPE)
    if(EXISTS "${prefix}/bvf-complete.txt")
        message(STATUS "OpenCV ${tag}: already built in ${prefix}")
        return()
    endif()
    file(LOCK "${prefix}.lock" GUARD FUNCTION TIMEOUT 21600)
    if(EXISTS "${prefix}/bvf-complete.txt")
        message(STATUS "OpenCV ${tag}: built by another job in ${prefix}")
        return()
    endif()
    # A short work folder, for the path length limit of Windows
    string(MD5 hash "${tag}")
    string(SUBSTRING "${hash}" 0 8 hash)
    set(work "${DEPS_DIR}/w${hash}")
    file(REMOVE_RECURSE "${work}" "${prefix}")
    set(repos opencv)
    if(BENCHMARKS STREQUAL "gpu")
        list(APPEND repos opencv_contrib)
    endif()
    foreach(repo IN LISTS repos)
        set(url "https://github.com/opencv/${repo}/archive/refs/tags/${OPENCV_VERSION}.tar.gz")
        if(repo STREQUAL "opencv")
            set(sha256 ${OPENCV_SHA256})
        else()
            set(sha256 ${OPENCV_CONTRIB_SHA256})
        endif()
        message(STATUS "Downloading ${url}")
        file(DOWNLOAD "${url}" "${work}/${repo}.tar.gz" STATUS status INACTIVITY_TIMEOUT 300 TLS_VERIFY ON
             EXPECTED_HASH SHA256=${sha256})
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Download of ${url} failed: ${status}")
        endif()
        file(ARCHIVE_EXTRACT INPUT "${work}/${repo}.tar.gz" DESTINATION "${work}")
    endforeach()
    set(options -G "${GENERATOR}" -S "${work}/opencv-${OPENCV_VERSION}" -B "${work}/build"
        -DCMAKE_BUILD_TYPE=Release "-DCMAKE_INSTALL_PREFIX=${prefix}"
        "-DCMAKE_C_COMPILER=${OPENCV_C_COMPILER}" "-DCMAKE_CXX_COMPILER=${OPENCV_CXX_COMPILER}"
        -DBUILD_LIST=${modules} -DBUILD_SHARED_LIBS=ON -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF -DBUILD_EXAMPLES=OFF
        -DBUILD_DOCS=OFF -DBUILD_opencv_apps=OFF -DBUILD_JAVA=OFF -DBUILD_opencv_python3=OFF
        -DOPENCV_GENERATE_SETUPVARS=OFF -DWITH_FFMPEG=OFF -DWITH_GSTREAMER=OFF -DWITH_GTK=OFF -DWITH_QT=OFF
        -DWITH_V4L=OFF -DWITH_MSMF=OFF -DWITH_DSHOW=OFF)
    if(BENCHMARKS STREQUAL "gpu")
        list(APPEND options -DWITH_CUDA=ON "-DOPENCV_EXTRA_MODULES_PATH=${work}/opencv_contrib-${OPENCV_VERSION}/modules"
             "-DCUDA_TOOLKIT_ROOT_DIR=${CUDA_ROOT}" -DCUDA_ARCH_BIN=${CUDA_ARCH_BIN} -DCUDA_ARCH_PTX=
             -DWITH_CUDNN=OFF -DWITH_NVCUVID=OFF -DWITH_NVCUVENC=OFF)
    else()
        list(APPEND options -DWITH_CUDA=OFF)
    endif()
    run(opencv_configure FATAL COMMAND "${CMAKE_COMMAND}" ${options})
    run(opencv_build FATAL COMMAND "${CMAKE_COMMAND}" --build "${work}/build" --target install --parallel ${JOBS})
    file(WRITE "${prefix}/bvf-complete.txt" "OpenCV ${tag} (modules ${modules}), built by scripts/ci/run_benchmarks.cmake\n")
    file(REMOVE_RECURSE "${work}")
endfunction()

build_opencv(OPENCV_PREFIX)

# Shared libraries found at run time: Linux executables have RPATHs, Windows needs the folders in the PATH
if(CMAKE_HOST_WIN32)
    file(GLOB_RECURSE opencvDlls "${OPENCV_PREFIX}/*opencv_core*.dll")
    set(runtimePath "")
    foreach(dll IN LISTS opencvDlls)
        get_filename_component(dir "${dll}" DIRECTORY)
        list(APPEND runtimePath "${dir}")
    endforeach()
    if(BENCHMARKS STREQUAL "gpu")
        list(APPEND runtimePath "${CUDA_ROOT}/bin" "${CUDA_ROOT}/bin/x64" "${CUDA_ROOT}/extras/CUPTI/lib64")
    endif()
    list(REMOVE_DUPLICATES runtimePath)
    foreach(dir IN LISTS runtimePath)
        file(TO_NATIVE_PATH "${dir}" dir)
        set(ENV{PATH} "${dir};$ENV{PATH}")
    endforeach()
endif()

# Configures and builds one benchmark project in BUILD_DIR/<NAME>
function(build_benchmark NAME SOURCE)
    set(options -G "${GENERATOR}" -S "${SOURCE}" -B "${BUILD_DIR}/${NAME}" -DCMAKE_BUILD_TYPE=Release
        "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" "-DCMAKE_PREFIX_PATH=${OPENCV_PREFIX}" ${ARGN})
    run(${NAME}_configure FATAL COMMAND "${CMAKE_COMMAND}" ${options})
    if(CMAKE_HOST_WIN32 AND CUDA_COMPILER AND EXISTS "${BUILD_DIR}/${NAME}/CMakeFiles/rules.ninja")
        # The same workaround as FKL's Windows CUDA CI: CMake writes an nvcc path without its toolkit folder
        file(READ "${BUILD_DIR}/${NAME}/CMakeFiles/rules.ninja" rules)
        file(TO_NATIVE_PATH "${CUDA_COMPILER}" nvcc)
        string(REPLACE "\\nvcc\\bin\\nvcc.exe" "${nvcc}" rules "${rules}")
        file(WRITE "${BUILD_DIR}/${NAME}/CMakeFiles/rules.ninja" "${rules}")
    endif()
    run(${NAME}_build FATAL COMMAND "${CMAKE_COMMAND}" --build "${BUILD_DIR}/${NAME}" --parallel ${JOBS})
endfunction()

if(BENCHMARKS STREQUAL "cpu")
    build_benchmark(cpu "${REPO}/cpu")
    run(cpu_bench COMMAND "${BUILD_DIR}/cpu/cpu_bench${EXE}" "${OUT_DIR}/cpu")
    check_csv("${OUT_DIR}/cpu/cpu_validation.csv" "FKL MaxAbsError vs FKL-convention reference" 1e-3)
    check_csv("${OUT_DIR}/cpu/cpu_validation.csv" "FKL CPU_MULTITHREAD vs FKL CPU MaxAbsDifference" 1e-3)
else()
    set(cudaOptions "-DCMAKE_CUDA_COMPILER=${CUDA_COMPILER}")
    if(NOT CMAKE_HOST_WIN32)
        list(APPEND cudaOptions "-DCMAKE_CUDA_HOST_COMPILER=${CXX_COMPILER}")
    endif()
    build_benchmark(gpu "${REPO}" ${cudaOptions})
    set(bench "${BUILD_DIR}/gpu/bvf_bench${EXE}")
    run(bvf_types COMMAND "${BUILD_DIR}/gpu/bvf_types${EXE}")
    run(bvf_bench COMMAND "${bench}" "${OUT_DIR}/gpu")
    run(bvf_bench_l2_flushed COMMAND "${bench}" "${OUT_DIR}/gpu" --gpu-only-l2-flushed)
    run(bvf_bench_profile_kernels COMMAND "${bench}" "${OUT_DIR}/gpu" --profile-kernels)
    run(bvf_bench_host_overhead COMMAND "${bench}" "${OUT_DIR}/gpu" --host-overhead)
    run(bvf_bench_ncu_target COMMAND "${bench}" "${OUT_DIR}/ncu_targets" --ncu-target fkl_bvf 16)
    run(bvf_bench_region_sweep COMMAND "${bench}" "${OUT_DIR}/region_sweep" --region-sweep)
    run(bvf_bench_region_ncu_target COMMAND "${bench}" "${OUT_DIR}/ncu_targets" --region-ncu-target fkl_bvf A)
    # FKL's two pipelines must match FKL's CPU backend; the baselines' errors are reported, not checked (OpenCV and
    # NPP round and sample differently, see the README)
    check_csv("${OUT_DIR}/gpu/validation.csv" within_tolerance_1e-3 yes FILTER_COLUMN implementation FILTER "^fkl_")
    check_csv("${OUT_DIR}/gpu/validation.csv" non_finite_values 0)
    check_csv("${OUT_DIR}/region_sweep/region_sweep_validation.csv" within_tolerance_1e-3 yes
              FILTER_COLUMN implementation FILTER "^fkl_")
    check_csv("${OUT_DIR}/region_sweep/region_sweep_validation.csv" non_finite_values 0)
    if(NPPDX)
        build_benchmark(nppdx "${REPO}/fkl-vs-nppdx" ${cudaOptions})
        set(nppdx "${BUILD_DIR}/nppdx/benchmark_figure1_bvf${EXE}")
        run(nppdx_bench COMMAND "${nppdx}" "${OUT_DIR}/nppdx")
        run(nppdx_bench_l2_flushed COMMAND "${nppdx}" "${OUT_DIR}/nppdx" --gpu-only-l2-flushed)
        run(nppdx_bench_analyze COMMAND "${nppdx}" "${OUT_DIR}/nppdx" --analyze)
        run(nppdx_bench_ncu_target COMMAND "${nppdx}" "${OUT_DIR}/ncu_targets" --ncu-target nppdx 16)
        run(nppdx_bench_region_sweep COMMAND "${nppdx}" "${OUT_DIR}/region_sweep/nppdx" --region-sweep)
        run(nppdx_bench_region_ncu_target COMMAND "${nppdx}" "${OUT_DIR}/ncu_targets" --region-ncu-target fkl_bvf A)
        # NPPDx is checked against its own sampling convention; in the region sweep only FKL is, since which NPPDx
        # tiles fit depends on the shared memory of the GPU
        set(validation "${OUT_DIR}/nppdx/benchmark_figure1_bvf_validation_GPU_NVIDIA.csv")
        check_csv("${validation}" "FKL MaxAbsError vs FKL reference" 1e-3)
        check_csv("${validation}" "NPPDx MaxAbsError vs pixel-center reference" 1e-3)
        check_csv("${OUT_DIR}/region_sweep/nppdx/benchmark_figure1_bvf_region_sweep_validation_GPU_NVIDIA.csv"
                  "FKL MaxAbsError vs FKL reference" 1e-3)
    else()
        message(STATUS "FKL vs NPPDx not built: NPPDx supports x86_64 CPUs only (set NPPDX=ON to try)")
    endif()
endif()

if(FAILURES)
    list(JOIN FAILURES "\n  " failures)
    message(FATAL_ERROR "Failures:\n  ${failures}")
endif()
message(STATUS "All benchmarks ran and FKL's outputs match their references. Results in ${OUT_DIR}")
